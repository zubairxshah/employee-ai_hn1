# Cloud Environment Variables
# This file contains ONLY cloud-safe credentials (read-oriented)
# NEVER include: GMAIL_APP_PASSWORD, WHATSAPP_*, BANK_API_TOKEN

# Agent Configuration
AGENT_ROLE=cloud
AGENT_ID=cloud-oracle-vm

# Vault
VAULT_PATH=/app/vault
VAULT_SYNC_ENABLED=true
VAULT_REMOTE_URL=git@github.com:your-user/ai-employee-vault.git
VAULT_SYNC_INTERVAL=60

# Gmail (READ-ONLY - no app password)
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_CLIENT_ID=your_client_id
GMAIL_CLIENT_SECRET=your_client_secret
GMAIL_REFRESH_TOKEN=your_refresh_token

# LinkedIn (read + draft)
LINKEDIN_CLIENT_ID=your_client_id
LINKEDIN_CLIENT_SECRET=your_client_secret

# Facebook (read + draft)
FACEBOOK_APP_ID=your_app_id
FACEBOOK_APP_SECRET=your_app_secret
FACEBOOK_PAGE_ID=your_page_id

# Twitter (read + draft)
X_CONSUMER_KEY=your_consumer_key
X_SECRET_KEY=your_secret_key
X_BEARER_TOKEN=your_bearer_token
X_OAUTH2_CLIENT_ID=your_oauth2_client_id
X_OAUTH2_CLIENT_SECRET=your_oauth2_client_secret

# Odoo (cloud instance)
ODOO_URL=http://odoo:8069
ODOO_DATABASE=odoo
ODOO_USERNAME=admin
ODOO_PASSWORD=your_odoo_password

# PostgreSQL
POSTGRES_PASSWORD=odoo_secure_password

# Security
DEV_MODE=false
DRY_RUN=false
MAX_EMAILS_PER_HOUR=10
MAX_PAYMENTS_PER_HOUR=3

# Cloud Poll Interval (seconds)
CLOUD_POLL_INTERVAL=30
