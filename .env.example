# .env - NEVER commit this file
# AI Personal Employee Environment Variables

# Gmail SMTP Credentials (for sending emails)
# Get App Password from: https://myaccount.google.com/apppasswords
# 1. Go to Google Account > Security
# 2. Enable 2-Step Verification
# 3. Go to: https://myaccount.google.com/apppasswords
# 4. Select "Mail" and your device, then copy the 16-character password
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Gmail API Credentials (for reading emails)
# Follow GMAIL_SETUP.md to obtain these
GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REFRESH_TOKEN=your_refresh_token_here

# LinkedIn API Credentials (for posting)
# Follow LINKEDIN_MCP_SETUP.md to obtain these
# 1. Go to https://www.linkedin.com/developers/
# 2. Create a new app
# 3. Copy Client ID and Client Secret
# 4. Set redirect URI to: http://localhost:8002/callback
# 5. Request products: w_member_social, r_liteprofile
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here
# LINKEDIN_ACCESS_TOKEN and LINKEDIN_PERSON_URN will be populated after OAuth flow

# Facebook/Instagram API Credentials (for posting)
# 1. Go to https://developers.facebook.com/
# 2. Create a new app (Business type)
# 3. Add Facebook Login product
# 4. Copy App ID and App Secret
# 5. Set redirect URI to: http://localhost:8006/callback
# 6. Request permissions: pages_manage_posts, pages_read_engagement,
#    instagram_basic, instagram_content_publish
FACEBOOK_APP_ID=your_app_id_here
FACEBOOK_APP_SECRET=your_app_secret_here
FACEBOOK_REDIRECT_URI=http://localhost:8006/callback
# These will be populated after OAuth flow:
# FACEBOOK_PAGE_ID=your_page_id
# FACEBOOK_PAGE_ACCESS_TOKEN=your_page_token
# INSTAGRAM_ACCOUNT_ID=your_ig_account_id

# Twitter (X) API Credentials (for posting)
# 1. Go to https://developer.twitter.com/en/portal/projects-and-apps
# 2. Create a new project and app
# 3. Set up OAuth 2.0 (User Authentication Settings)
# 4. Set redirect URI to: http://localhost:8007/callback
# 5. Copy Client ID and Client Secret
TWITTER_CLIENT_ID=your_client_id_here
TWITTER_CLIENT_SECRET=your_client_secret_here
TWITTER_REDIRECT_URI=http://localhost:8007/callback

# Banking API Token
BANK_API_TOKEN=your_bank_api_token_here

# WhatsApp Session Path
WHATSAPP_SESSION_PATH=/secure/path/to/whatsapp/session

# WhatsApp Notification Phone (for approval alerts)
# Format: +1234567890 (with country code, no spaces or special chars)
# Example: +12125551234 for US numbers
WHATSAPP_NOTIFICATION_PHONE=+1234567890

# Odoo ERP Credentials (Gold Tier - Accounting)
# Follow Odoo setup guide to configure
# 1. Install Odoo Community Edition (local or cloud)
# 2. Create database and configure accounting
# 3. Set username and password/API key
ODOO_URL=http://localhost:8069
ODOO_DATABASE=odoo
ODOO_USERNAME=admin
ODOO_PASSWORD=your_odoo_password_or_api_key_here

# Security Settings
DEV_MODE=true
DRY_RUN=true
MAX_EMAILS_PER_HOUR=10
MAX_PAYMENTS_PER_HOUR=3

# Claude API Key (optional — only needed for the original reasoning_module fallback)
CLAUDE_API_KEY=your_claude_api_key_here

# LLM Brain provider — "gemini" (default) or "openrouter"
LLM_BRAIN_PROVIDER=gemini

# Gemini provider (https://aistudio.google.com/apikey — free tier is 20 req/day per model)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override (default: gemini-2.5-flash)
LLM_BRAIN_MODEL=gemini-2.5-flash

# OpenRouter provider (https://openrouter.ai/keys)
# Many free models available; quality and availability vary by upstream host
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional model override (default: deepseek/deepseek-v4-flash:free)
# Verified working examples for tool-use: openai/gpt-oss-120b:free, moonshotai/kimi-k2.6:free
LLM_BRAIN_OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free

# Vault Path
VAULT_PATH=D:\prompteng\AI_Employee_Vault

# ==================== Platinum Tier ====================
# Agent Role: 'cloud' or 'local' (default: local)
AGENT_ROLE=local
# Unique agent identifier (auto-generated if not set)
AGENT_ID=
# Enable git-based vault sync (default: false)
VAULT_SYNC_ENABLED=false
# Git remote URL for vault sync
VAULT_REMOTE_URL=
# Vault sync interval in seconds (default: 60)
VAULT_SYNC_INTERVAL=60